# ==============================================================================
# GOOGLE ADMOB ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to `.env` or set these in EAS Secrets / Dashboard.
# If omitted or left blank, the app safely defaults to official Google Test Ad IDs.

# 1. AdMob Application IDs (from AdMob Console -> App Settings)
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=

# 2. AdMob Ad Unit IDs (from AdMob Console -> Ad Units)
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=

EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_ID=
